<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.lab5.LabelController"
            prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER" spacing="15.0"
          AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">

        <TextField fx:id="leftField" prefWidth="200.0" promptText="Введите текст"/>
        <Button fx:id="moveButton" text="→" prefWidth="60.0" onAction="#onMove"/>
        <TextField fx:id="rightField" prefWidth="200.0" editable="false"/>

    </HBox>

</AnchorPane>
